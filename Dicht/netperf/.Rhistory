
# Load packages
library(tidyverse)
library(dplyr)
library(ggplot2)
library(readr)
# Set Working Directory
setwd("~/Documents/container_ditch-main/findings/Docker_ditch/Dicht/netperf/")
# Import netperf file
netperf<- readr::read_csv("netperf_final.csv")
p<- ggplot(netperf, aes(x=MessageSize, y=TCP_mean, fill=Environment,label=TCP_mean)) +
geom_bar(stat="identity", color="black",alpha=1,width=0.8,
position=position_dodge()) +
geom_errorbar(aes(ymin=TCP_mean-TCP_std, ymax=TCP_mean+TCP_std), width=.2,
position=position_dodge(.9))+
labs(x="Packet size in bytes", y="Throughput MB/s")
p +theme_linedraw() + theme(legend.position = "top",legend.title = element_blank(),
legend.text = element_text( size = 21),
axis.text.x  = element_text(vjust=0.5, size=22,angle=30),
axis.text.y  = element_text(vjust=0.5, size=22),
axis.title.x = element_text(vjust=0.5, size=22,color = "black"),
axis.title.y = element_text(vjust=0.5, size=22,color = "black"))
